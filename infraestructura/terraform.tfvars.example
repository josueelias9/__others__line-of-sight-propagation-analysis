# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars must NEVER be committed to source control (already in .gitignore).

project_name = "lospa"
environment  = "prod"
location     = "eastus"

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
postgres_admin_username = "psqladmin"
postgres_admin_password = "ChangeMe_Str0ng!"  # min 8 chars, upper+lower+digit+symbol
postgres_db_name        = "app_db"

# SKU options:
#   B_Standard_B1ms  → Burstable, 1 vCore  2 GB  ~$12/mo  (dev / low traffic)
#   B_Standard_B2ms  → Burstable, 2 vCores 4 GB  ~$24/mo
#   GP_Standard_D2s_v3 → General Purpose    ~$95/mo  (recommended for production)
postgres_sku = "B_Standard_B1ms"

# ── Frontend (baked into the Docker image at build time) ───────────────────────
next_public_google_maps_api_key = "YOUR_GOOGLE_MAPS_API_KEY"
next_public_google_maps_map_id  = "YOUR_GOOGLE_MAPS_MAP_ID"

# ── App Service Plan ────────────────────────────────────────────────────────────
# B1 Basic is sufficient for a POC and does not require Standard VM quota.
# Upgrade to S1/P1v3 + VNet integration for production.
# SKU options:
#   B1  → Basic     1 vCore  1.75 GB  ~$13/mo  (POC)
#   B2  → Basic     2 vCores 3.5  GB  ~$26/mo
#   S1  → Standard  1 vCore  1.75 GB  ~$73/mo  (needed for VNet integration)
#   P1v3 → Premium v3                 ~$85/mo  (production)
app_service_plan_sku = "B1"

image_tag = "latest"
